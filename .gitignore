# --- Runtime state (never commit) -------------------------------------------
# Application data: database files, task workspaces, uploads, logs.
/data/
# Assessment run outputs and engagement deliverables (regenerated by apkassess --out).
/reports/
# Local, non-source material moved out of the source tree (old notes, upstream docs).
/archive/
*.db
*.db-wal
*.db-shm
config.json
scheduler_state.json
# Scheduler run/simulation event logs (test artifacts).
*-events.csv
# Local Docker deployment environment (contains passwords/keys).
.env
# JWT signing key (generated at runtime in the project root).
/jwt.key
/identity/

# --- Build output ------------------------------------------------------------
# Single binary with the embedded web UI, plus self-update intermediates
# (staged / backup / failed builds and the upgrade marker).
/artex
/artex.new
/artex.new.sha256
/artex.old
/artex.failed
/artex.upgrade.json
/androidlab
/androidlab-dev
/apkassess
/apktriage
/internal/server/webui/dist/
/dist/

# --- Frontend ----------------------------------------------------------------
web/node_modules/
web/.next/
web/out/
web/tsconfig.tsbuildinfo
web/next-env.d.ts
*.local

# --- Python ------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.venv/

# --- Benchmarks (local artifacts) ---------------------------------------------
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2

# --- Caido (private SDK environment, binaries and instance data) -------------
.caido-venv/
.caido/

# --- Tooling / editors / OS --------------------------------------------------
.playwright-mcp/
.playwright-cli/
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Local development state -------------------------------------------------
.claude/
/.codex/
/internal/sidequestion/validation-*.json

# --- Uploaded engagement material & provided secrets (never commit) ----------
# Uploaded Android apps. The tool stores these under /data/ (already ignored);
# these also catch loose copies dropped anywhere in the tree.
*.apk
*.aab
*.apks
*.xapk
*.idsig
# Signing keys, keystores, certificates and private keys.
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
# LLM / API keys and other secrets handed to the tool (config.json and .env are
# already ignored above; these cover separate key/secret files).
secrets.json
secrets.*.json
*.secret
*.apikey
api_key*.txt
apikey*.txt
llm_key*
llm.key
# Loose uploaded goals/instructions kept outside the DB (the tool stores task
# goals/instructions in the database under /data/).
/uploads/

# --- Build / export artifacts & large generated outputs (never commit) -------
*.zip
*.tar
*.tar.gz
*.tgz
# Generated differential/validation outputs (large; regenerated by the harness).
/validation/results/
/validation/.venv/
/validation/evidence-pack/
