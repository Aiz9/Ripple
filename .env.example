# Ripple only. Copy to Android/.env and choose a strong password.
# Use URL-safe characters because Compose embeds this value in the database URL.
POSTGRES_PASSWORD=replace-with-a-unique-password
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
# Gemini: set the provider below to gemini and select an available model ID.
# GEMINI_API_KEY takes precedence over GOOGLE_API_KEY. No default Gemini model.
ANDROIDLAB_LLM_PROVIDER=
ANDROIDLAB_LLM_MODEL=
ANDROIDLAB_LLM_BASE_URL=
ANDROIDLAB_LLM_PROXY=

# Burp Suite MCP integration (autonomous traffic capture + replay).
# Point at a Burp instance with the "MCP Server" extension enabled. Burp's
# invisible proxy listener captures proxy-unaware apps (e.g. Flutter); the tool
# reads that history and replays requests via this endpoint. No key required.
ANDROIDLAB_BURP_MCP_URL=http://127.0.0.1:9876
