{
  "openapi": "3.0.3",
  "info": { "title": "Example API contract — discovery only", "version": "1.0" },
  "servers": [{ "url": "https://api.example.invalid/api" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/profile": { "get": { "responses": { "200": { "description": "Profile" } } } },
    "/auth/refresh": { "post": { "responses": { "200": { "description": "Refresh result" } } } },
    "/orders/{orderId}": {
      "get": {
        "parameters": [{ "name": "orderId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Order" } }
      }
    }
  },
  "components": { "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer" } } }
}
